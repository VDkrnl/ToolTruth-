# Database
DATABASE_URL=sqlite:///./tooltruth.db

# Auth - replace both values before production
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION

# Production object storage (private bucket)
S3_BUCKET=YOUR_PRIVATE_S3_BUCKET
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# API / CORS
CORS_ORIGINS=https://YOUR-USERNAME.github.io
MAX_FILE_SIZE_MB=25

# false when S3 is configured for production
LOCAL_STORAGE=false

# Public API used for local file preview URLs
PUBLIC_API_URL=https://api.tooltruth.duckdns.org

# Linux production host
LIBREOFFICE_BIN=libreoffice
