[Unit]
Description=ToolTruth FastAPI API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/tooltruth/backend
EnvironmentFile=/opt/tooltruth/backend/.env
ExecStart=/opt/tooltruth/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
