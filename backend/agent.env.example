# Copy to backend/agent.env (git-ignored). Loaded ONLY into the agent service process by run_local.ps1.
# Never put SHOPIFY_* here.

# ── Agent mode ────────────────────────────────────────────────────────────────
# "shopping"        (default) — search/buy agent against the Shopify store.
# "shopify_content" — manage Shopify store content (products, pages, blogs, …).
# TT_AGENT_MODE=shopping
# TT_AGENT_MODE=shopify_content

# When using the shopify_content agent, also set:
# TT_PROVIDER=shopify_content

# Free option A: Groq (create a key at console.groq.com)
TT_LLM_API_KEY=
TT_LLM_BASE_URL=https://api.groq.com/openai/v1
TT_AGENT_MODEL=openai:openai/gpt-oss-120b

# Free option B: OpenRouter (openrouter.ai) -> base https://openrouter.ai/api/v1 , model openai:openai/gpt-oss-120b:free
